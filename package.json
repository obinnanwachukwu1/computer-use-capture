{
  "name": "computer-use-capture",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Turn Codex Computer Use sessions into polished macOS product-demo videos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinnanwachukwu1/computer-use-capture.git"
  },
  "homepage": "https://github.com/obinnanwachukwu1/computer-use-capture#readme",
  "bugs": {
    "url": "https://github.com/obinnanwachukwu1/computer-use-capture/issues"
  },
  "type": "module",
  "bin": {
    "computer-use-capture": "scripts/mcp-server.mjs"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "docs/mcp-tools.schema.json",
    "lib/",
    "scripts/mcp-server.mjs",
    "scripts/recorder-daemon.mjs",
    "scripts/record-session.mjs",
    "scripts/compose-recording.mjs",
    "scripts/analyze-capture-quality.mjs",
    "vendor/darwin-arm64/"
  ],
  "scripts": {
    "reprocess": "node scripts/reprocess-timeline.mjs",
    "test": "node --test",
    "demo": "python3 -m http.server 4173 --directory demo",
    "compose": "node scripts/compose-recording.mjs",
    "record": "node scripts/record-session.mjs",
    "audit:accessibility": "node scripts/audit-accessibility-vocabulary.mjs",
    "audit:alignment": "node scripts/validate-alignment.mjs",
    "build:prebuilt": "node scripts/build-prebuilt.mjs",
    "verify:prebuilt": "node scripts/verify-prebuilt.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build:prebuilt && npm run verify:prebuilt",
    "compare:experimental": "node scripts/compare-camera-plans.mjs --planners normal,experimental",
    "golden:update": "node scripts/golden-director-plans.mjs update",
    "test:golden": "node scripts/golden-director-plans.mjs verify",
    "benchmark:pipeline": "node scripts/benchmark-pipeline.mjs",
    "analyze:capture-quality": "node scripts/analyze-capture-quality.mjs",
    "evaluate:camera": "node scripts/evaluate-camera-factorial.mjs",
    "evaluate:camera-bakeoff": "node scripts/evaluate-camera-bakeoff.mjs",
    "verify:oracle": "node scripts/verify-oracle-support.mjs",
    "mcp": "node scripts/mcp-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acorn": "^8.17.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  }
}
